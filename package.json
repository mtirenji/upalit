# Create package.json with proper JSON
$packageJson = @'
{
  "name": "upalit-backend",
  "version": "0.1.0",
  "description": "Auth + admin panel backend for Upalit",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/utils/seed.js",
    "deploy": "npx wrangler deploy",
    "deploy:preview": "npx wrangler deploy --env preview",
    "test": "node src/utils/test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hono": "^4.6.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
'@

$packageJson | Out-File -FilePath package.json -Encoding utf8