# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

PORT=4000

# Use long, random, unpredictable secrets in production (openssl rand -hex 64)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Seed the first admin account (only used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@upalit.com
SEED_ADMIN_PASSWORD=change_this_immediately
